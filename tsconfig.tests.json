{
  "extends": "./tsconfig.json",
  "include": [
    "src/env.d.ts",
    "src/test/vitest.d.ts",
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "scada-proxy"],
  "compilerOptions": {
    "allowJs": false,
    "types": ["node", "vite/client", "vitest/globals"]
  }
}
