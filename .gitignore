# Dependencies
node_modules/

# Build output
dist/
# Paired-A/B arms built by test-results/.../allab.mjs and allvisual.mjs. Kept on
# disk between runs because rebuilding a control arm is the expensive part of an
# A/B, and an untracked 129 MB build directory in `git status` is not.
dist-control/
dist-treatment/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Cache
.cache/
.parcel-cache/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Test coverage reports (regenerated by `npm run test:coverage`)
coverage/

# Whole-machine mutex for anything that renders (scripts/lib/capture-lock.mjs)
/.capture.lock

# Generated agent manifest (npm run agent:manifest); CI regenerates it.
/build/generated/

# Local render experiments, duplicated baselines and temporary icon work.
# Selected concept art and final review galleries are explicitly checked in.
# Working if regeneration leaves status clean while curated art remains tracked.
/output/*-2026*/
/tmp/

# Python bytecode is regenerated from the checked-in Blender scripts.
# Working if running an asset builder adds no bytecode to git status.
__pycache__/
*.pyc
