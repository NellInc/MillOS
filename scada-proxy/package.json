{
  "name": "millos-scada-proxy",
  "version": "1.0.0",
  "description": "Backend proxy for MillOS SCADA - bridges OPC-UA/Modbus to REST/WebSocket",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "lint": "eslint src tests eslint.config.cjs",
    "test:trust": "npm run build && node --test --test-concurrency=1 tests/opcua-certificate-trust.test.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.2.1",
    "modbus-serial": "^8.0.16",
    "node-opcua-client": "^2.170.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "eslint": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.65.0",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "overrides": {
    "express": {
      "body-parser": "^1.20.9"
    }
  }
}
