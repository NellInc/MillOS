{
  "name": "millos-scada-proxy",
  "version": "1.0.0",
  "description": "Backend proxy for MillOS SCADA - bridges OPC-UA/Modbus to REST/WebSocket",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "lint": "eslint src test eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"*.{json,yml,yaml,mjs}\" \"k8s/*.yaml\" \"*.md\"",
    "test": "npm run build && node --test test/**/*.test.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "modbus-serial": "^8.0.16",
    "node-opcua-client": "^2.115.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "3.7.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
