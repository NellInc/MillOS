# MillOS SCADA Proxy Configuration

# Environment (development | production)
# CRITICAL: Production deployments MUST set NODE_ENV=production for OPC-UA encryption
NODE_ENV=development

# Server port
PORT=3001

# Polling interval (ms)
POLL_INTERVAL=1000

# Browser and reverse proxy security
# Production must list every exact browser origin. Wildcards and paths are rejected.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=0

# API authentication. Required when NODE_ENV=production.
# Keep real values in a secret manager, not this file.
# SCADA_API_KEY=replace-with-a-long-random-secret

# Industrial writes fail closed. Enabling them requires a distinct production key.
SCADA_ENABLE_WRITES=false
# SCADA_WRITE_API_KEY=replace-with-a-different-long-random-secret

# Capacity and abuse controls
RATE_LIMIT_MAX=2000
WRITE_RATE_LIMIT_MAX=120
WS_MESSAGE_RATE_MAX=120
WS_MAX_CLIENTS=100

# OPC-UA Server (optional)
# OPCUA_ENDPOINT=opc.tcp://localhost:4840
# Security: development uses SecurityMode=None, production uses SignAndEncrypt
# OPCUA_USERNAME=operator
# OPCUA_PASSWORD=replace-with-secret
# OPCUA_CLIENT_CERTIFICATE_FILE=/run/secrets/opcua-client-cert.pem
# OPCUA_CLIENT_PRIVATE_KEY_FILE=/run/secrets/opcua-client-key.pem

# Modbus TCP (optional)
# MODBUS_HOST=192.168.1.100
# MODBUS_PORT=502
