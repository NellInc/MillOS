{
  "name": "grain-mill-simulator",
  "private": true,
  "version": "0.40.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "play:chatgpt": "npm run build && node scripts/chatgpt-local.mjs",
    "build": "vite build",
    "build:archives": "node scripts/package-static-archives.mjs",
    "build:pages-staging": "node scripts/build-pages-staging.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:chatgpt": "node --test scripts/chatgpt-local-server.node-check.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "agent:manifest": "node scripts/generate-agent-manifest.mjs",
    "agent:manifest:check": "node scripts/generate-agent-manifest.mjs --check",
    "agent:brief": "node scripts/agent-brief.mjs",
    "agent:measure-query": "node scripts/measure-agent-query-plane.mjs",
    "agent:typecheck": "tsc --noEmit -p tsconfig.agent.json",
    "bench": "vitest bench",
    "benchmark:runtime": "node scripts/run-performance-benchmark.mjs",
    "benchmark:runtime:report": "node scripts/run-performance-benchmark.mjs --report-only",
    "capture:art": "node scripts/capture-art-review.mjs",
    "capture:operations": "node scripts/capture-operational-review.mjs",
    "review:stage-ab": "node scripts/stage-blind-ab.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "setup:basis": "./scripts/setup-basis-transcoder.sh",
    "convert-textures": "node scripts/convert-textures.mjs",
    "convert-textures:dry": "node scripts/convert-textures.mjs --dry-run",
    "normalize-models": "node scripts/normalize-model-assets.mjs",
    "normalize-models:dry": "node scripts/normalize-model-assets.mjs --dry-run",
    "provenance:models": "node scripts/write-model-provenance.mjs",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "optimize-assets:dry": "node scripts/optimize-assets.mjs --dry-run",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:depth": "node scripts/validate-depth-policy.mjs",
    "validate:shaders": "node scripts/validate-shaders.mjs",
    "validate:bundle": "node scripts/validate-bundle.mjs",
    "generate:soundtrack": "node scripts/generate-millos-soundtrack-assets.mjs",
    "validate:soundtrack": "node scripts/generate-millos-soundtrack-assets.mjs --check",
    "validate:reachability": "node scripts/audit-module-reachability.mjs",
    "analyze:materials": "node scripts/analyze-material-sharing.mjs",
    "measure:surfaces": "node scripts/measure-surface-contrast.mjs",
    "validate:community": "node scripts/validate-uncrewed-build.mjs",
    "validate:uncrewed": "npm run validate:community",
    "validate:releases": "node scripts/validate-release-matrix.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "@napi-rs/keyring": "^2.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "framer-motion": "^12.23.26",
    "jose": "^6.2.12",
    "lucide-react": "^0.562.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.38.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "meshoptimizer": "^1.2.0",
    "postcss": "^8.5.23",
    "prettier": "^3.7.4",
    "puppeteer": "^24.34.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.54.0"
  },
  "overrides": {
    "stats-gl": {
      "three": "^0.182.0"
    },
    "tunnel-rat": {
      "zustand": "^5.0.0"
    }
  }
}
