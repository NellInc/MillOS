index fc527b0..cec9239 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -49,10 +49,18 @@ jobs:
       - name: Build current release
         run: VERSION="v$(node -p "require('./package.json').version.split('.').slice(0, 2).join('.')")" npm run build
 
+      - name: Rebuild the deployed v0.40 release for preservation
+        run: |
+          V040_SOURCE_SHA=$(node -e "const m=require('./release-matrix.json'); process.stdout.write(m.releases.find((r) => r.version === 'v0.40').sourceCommit)")
+          git worktree add --detach "$RUNNER_TEMP/millos-v040" "$V040_SOURCE_SHA"
+          npm ci --force --ignore-scripts --prefix "$RUNNER_TEMP/millos-v040"
+          VERSION=v0.40 GITHUB_SHA="$V040_SOURCE_SHA" npm run build --prefix "$RUNNER_TEMP/millos-v040"
+
       - name: Stage current and archived releases
         run: |
           npm run build:pages-staging -- \
-            --archive-build "v0.30=$RUNNER_TEMP/millos-v030/dist"
+            --archive-build "v0.30=$RUNNER_TEMP/millos-v030/dist" \
+            --archive-build "v0.40=$RUNNER_TEMP/millos-v040/dist"
           npm run validate:releases -- --staging staging
 
       - name: Setup Pages
